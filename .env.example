# ============================================
# APPLICATION & SERVER
# ============================================
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://better-dev-ui.vercel.app,http://localhost:3000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Production (Render / Neon injected):
DATABASE_URL=postgresql://user:password@host:5432/better_dev_db

# Local Development fallback:
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=better_dev
DATABASE_PASSWORD=better_dev
DATABASE_NAME=better_dev_db

# ============================================
# AUTHENTICATION (JWT)
# ============================================
JWT_SECRET=generate-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRATION=7d

# ============================================
# AI PROVIDERS & MODELS (Groq)
# ============================================
GROQ_API_KEY=gsk_your_groq_api_key_here
DEFAULT_AI_MODEL=openai/gpt-oss-120b
AI_TEXT_MODEL=openai/gpt-oss-20b
AI_TOOL_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=openai/gpt-oss-120b

# ============================================
# SEARCH & TOOLS (Tavily)
# ============================================
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ============================================
# OBJECT STORAGE (Supabase Object Storage / S3-compatible)
# ============================================
# Active provider: Supabase Object Storage (free tier). We originally planned
# Cloudflare R2 but switched to Supabase because of price constraints.
# Everything goes through the AWS S3 SDK using Supabase's S3-compatible endpoint.
USE_S3_STORAGE=true
S3_BUCKET_NAME=better-dev-attachments
S3_REGION=ap-south-1
# Supabase Storage S3-compatible endpoint:
# https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# Keys generated in Supabase Dashboard → Storage → S3 Access Keys (same as project keys)
S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
# Public (unauthenticated) file URLs are served from:
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_CDN_URL=https://<project-ref>.supabase.co/storage/v1/object/public/your-bucket
# Supabase Storage does not allow setting object ACLs (REJECTS ACL headers).
S3_PUBLIC_READ=false
# Supabase Storage's S3 endpoint requires path-style URLs (bucket-as-first-path-segment).
S3_FORCE_PATH_STYLE=true

# --- Alternatives if you switch providers ---
# Cloudflare R2:  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#                 S3_FORCE_PATH_STYLE=false, S3_PUBLIC_READ=false, and set S3_CDN_URL
#                 to the bucket's public r2.dev URL or a custom domain.
# DigitalOcean Spaces: path-style URLs, S3_PUBLIC_READ=true (supports ACLs).

# Local filesystem storage (only used when USE_S3_STORAGE=false — development only)
LOCAL_STORAGE_PATH=./uploads

# ============================================
# TOKEN & UPLOAD LIMITS
# ============================================
MAX_DOCUMENT_TOKENS=32000
MAX_TOTAL_CONTEXT_TOKENS=64000
MAX_UPLOAD_SIZE_BYTES=10485760
